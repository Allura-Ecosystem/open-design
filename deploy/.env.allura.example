# Allura Design — Environment configuration
#
# Copy this file to .env and fill in the values before running:
#   cp deploy/.env.allura.example deploy/.env
#   docker compose -f deploy/docker-compose.allura.yml --env-file deploy/.env up -d

# ─── Open Design daemon ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
OD_API_TOKEN=

# Port to publish on the host (default: 7456)
ALLURA_DESIGN_PORT=7456

# Allowed browser origins for /api calls (set to your Cloudflare domain)
ALLURA_DESIGN_ALLOWED_ORIGINS=https://design.faithmeats.com

# Memory limit for the daemon container
ALLURA_DESIGN_MEM_LIMIT=384m

# Node heap cap
NODE_OPTIONS=--max-old-space-size=192

# ─── Allura Brain MCP ────────────────────────────────────────────────
# URL of the Allura Brain MCP server. Inside Docker, use
# host.docker.internal to reach a Brain running on the host.
# Default: http://host.docker.internal:5888/mcp
ALLURA_BRAIN_URL=http://host.docker.internal:5888/mcp

# ─── Hermes Agent ────────────────────────────────────────────────────
# Path to the Hermes config directory on the host (mounted read-only
# into the container so the daemon can detect hermes + its plugins).
HERMES_HOME=~/.hermes
HERMES_CONFIG_DIR=/home/open-design/.hermes

# ─── Cloudflare Tunnel ───────────────────────────────────────────────
# Cloudflare Tunnel token for design.faithmeats.com
# Create at: https://one.dash.cloudflare.com/ → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Image ───────────────────────────────────────────────────────────
# Override to pin a specific image (default: ghcr.io/allura-ecosystem/allura-design:latest)
ALLURA_DESIGN_IMAGE=ghcr.io/allura-ecosystem/allura-design:latest